# Local dev — copy to .env, edit values, never commit.
# Values below are the safe local defaults; leave TURSO_* + BLOB_* unset to use disk-backed SQLite + uploads/.

PORT=3000

# Admin gate for /api/prospects and DELETE. CHANGE IN PROD.
ADMIN_KEY=xentrix-dev-key

# Turso (leave blank for local file: SQLite)
# TURSO_DATABASE_URL=libsql://medbuild-form-xentrix.turso.io
# TURSO_AUTH_TOKEN=

# Vercel Blob for CV uploads (leave blank for local uploads/ folder)
# BLOB_READ_WRITE_TOKEN=
